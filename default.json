{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:enableMajor",
    ":dependencyDashboard",
    ":disableRateLimiting",
    ":enablePreCommit",
    ":separatePatchReleases",
    "helpers:pinGitHubActionDigests",
    "abandonments:recommended",
    "github>nklmilojevic/renovate-config:custom-managers.json5",
    "github>nklmilojevic/renovate-config:automerge-github-actions",
    "github>nklmilojevic/renovate-config:commit-message",
    "github>nklmilojevic/renovate-config:pr-labels"
  ],
  "timezone": "Europe/Belgrade",
  "dependencyDashboard": {
    "title": "Renovate Dashboard",
    "osvVulnerabilitySummary": "unresolved"
  },
  "suppressNotifications": [
    "prIgnoreNotification"
  ],
  "commitBodyTable": true,
  "rebaseWhen": "auto",
  "configMigration": true,
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "addLabels": [
      "security"
    ]
  },
  "gitIgnoredAuthors": [
    "192236397+homelab-crafter[bot]@users.noreply.github.com"
  ],
  "platformCommit": "enabled",
  "packageRules": [
    {
      "description": "Undo :separatePatchReleases for managers whose updates share a lock file. It splits minor and patch into separate lookup buckets, which runs before the update type is known, so this rule must not match on update type. Without it a group splits into <group> and patch-<group> branches.",
      "matchManagers": [
        "gomod",
        "cargo",
        "npm",
        "bun"
      ],
      "separateMinorPatch": false
    },
    {
      "description": "Every Go module update edits go.mod and go.sum, so separate PRs conflict as soon as one merges. Non-major updates land as one PR; majors stay separate. The go toolchain (golang-version datasource) keeps its own PR.",
      "matchManagers": [
        "gomod"
      ],
      "matchDatasources": [
        "go"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "Go modules"
    },
    {
      "description": "Every crate update edits Cargo.lock, so separate PRs conflict as soon as one merges. Non-major updates land as one PR; majors stay separate.",
      "matchManagers": [
        "cargo"
      ],
      "matchDatasources": [
        "crate"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "Rust crates"
    },
    {
      "description": "Every npm package update edits the package.json and lock file of its project, so separate PRs conflict as soon as one merges. Non-major updates land as one PR; majors stay separate.",
      "matchManagers": [
        "npm",
        "bun"
      ],
      "matchDatasources": [
        "npm"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "npm packages"
    }
  ]
}
